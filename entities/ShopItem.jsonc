{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in dollars"
    },
    "stock": {
      "type": "number",
      "default": 0
    },
    "photo_url": {
      "type": "string",
      "description": "Product photo"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Shown in the shop when true"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}